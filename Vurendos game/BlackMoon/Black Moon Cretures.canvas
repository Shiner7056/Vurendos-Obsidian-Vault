		{"id":"103b8310883f1bc1","type":"text","text":"Arlina is a skilled assassin that usually kills at noble party's. She uses her charm or poison to lure them into private to complete her contracts","x":-169,"y":-999,"width":332,"height":153,"color":"1"},
