		{"id":"54320487f460f9e3","type":"text","text":"Notes","x":2673,"y":-254,"width":250,"height":60,"color":"6"},
		{"id":"dcad741ffa73aa4f","type":"text","text":"Asked me to keep an eye on Invari and Sylvia as she suspects one of them is involved in the murders\n\nDetective Ashwen and Sylvia are in a relationship","x":434,"y":-608,"width":508,"height":204,"color":"#000000"},
		{"id":"f2e530ecf1e87a1c","type":"text","text":"Detective in Astelrath","x":563,"y":-194,"width":250,"height":60,"color":"#000000"},
